PORT=5000

# Supabase project URL (Settings > API > Project URL)
SUPABASE_URL=https://your-project.supabase.co

# แนะนำ: ใช้ service_role key ฝั่ง server (Settings > API > service_role secret)
# key นี้ bypass RLS ได้ทั้งหมด ห้ามใช้ในโค้ดฝั่ง client เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# (ตั้งชื่อ SUPABASE_KEY แทนก็ได้ — ใช้ค่าเดียวกัน)

# ทางเลือกสำรอง: ถ้าไม่ได้ตั้ง service_role key ระบบจะ fallback มาใช้ anon key นี้
# (ต้องเปิด RLS policy ให้ anon เขียน/อ่านได้เองใน Supabase)
SUPABASE_ANON_KEY=your_anon_or_publishable_key

# ---- Custom OTP ทางอีเมล: Resend API (จำเป็น) ----
# Resend Dashboard > API Keys
RESEND_API_KEY=re_xxxxxxxx
# ผู้ส่ง ต้องเป็นโดเมนที่ยืนยันใน Resend แล้ว ไม่ตั้ง = onboarding@resend.dev (ส่งถึงอีเมลเจ้าของบัญชี Resend เท่านั้น)
# RESEND_FROM=SupportFit <no-reply@yourdomain.com>

# ใช้เซ็น session token: สร้างด้วย node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your_random_secret

# ---- Gemini API (fallback ของ Voice Log parser เมื่อ parser ในเครื่องแยกข้อมูลได้ไม่ครบ) ----
# Google AI Studio > Get API key ไม่ตั้ง = ใช้ parser ในเครื่องอย่างเดียว
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.8-flash

# ---- Production ----
# origin ของ frontend ที่อนุญาตให้เรียก API (คั่นด้วย , ได้หลายอัน) ไม่ตั้ง = อนุญาตทุก origin
# CORS_ORIGIN=https://supportfit.vercel.app
# NODE_ENV=production บังคับให้ต้องตั้ง AUTH_SECRET

# ---- Postgres connection ตรง (ใช้สร้าง/อัปเดตตารางอัตโนมัติตอน start server) ----
# Supabase Dashboard > ปุ่ม Connect > Session pooler > URI (แทน [YOUR-PASSWORD] ด้วย Database password)
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres
